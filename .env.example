# PiGo Configuration
# Copy to ~/.pigo/.env (global) or ./pigo/.env (project)
# Project .env overrides the global one.
#
# You can also skip this file entirely and use /login in interactive mode:
# it walks you through provider selection + API key paste, verifies the key,
# and writes it to ~/.pigo/.env for you.

# ── Provider ─────────────────────────────────────────────────────
# deepseek (default) | opencode-go (OpenCode Go subscription)
# PIGO_PROVIDER=deepseek

# API key for the active provider (see below)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenCode Go key — https://opencode.ai/go (low-cost open models subscription)
# OPENCODE_API_KEY=oc-xxxxxxxxxxxxxxxx

# Model (provider default applies when unset or unknown):
#   deepseek:    deepseek-v4-flash | deepseek-v4-pro[1m] | deepseek-chat | deepseek-reasoner
#   opencode-go: deepseek-v4-flash | deepseek-v4-pro | mimo-v2.5 | mimo-v2.5-pro | ... (/models)
PIGO_MODEL=deepseek-v4-flash

# Thinking level: off | low | medium | high | max
PIGO_THINKING=medium

# Anthropic-compatible endpoint (tool calling).
# Defaults per provider; unset to use them:
#   deepseek:    https://api.deepseek.com/anthropic
#   opencode-go: https://opencode.ai/zen/go
# PIGO_BASE_URL=https://api.deepseek.com/anthropic

# Native OpenAI-compatible endpoint (CoT / reasoner, key verification).
# Defaults per provider; unset to use them:
#   deepseek:    https://api.deepseek.com
#   opencode-go: https://opencode.ai/zen/go
# PIGO_DS_BASE_URL=https://api.deepseek.com

# Max agent loop iterations per request
PIGO_MAX_TURNS=50

# Auto-repair on error: true | false
# PIGO_AUTOREPAIR=true

# Session storage directory (default ~/.pigo/sessions)
# PIGO_SESSION_DIR=/path/to/sessions

# Debug: dump API requests to stderr
# PIGO_DEBUG=1
