# PiGo Configuration
# Copy to ~/.pigo/.env (global) or ./pigo/.env (project)
# Project .env overrides the global one.

# API key (any of the three works; DEEPSEEK_API_KEY is recommended)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# Model: deepseek-v4-flash | deepseek-v4-pro[1m] | deepseek-chat | deepseek-reasoner
PIGO_MODEL=deepseek-v4-flash

# Thinking level: off | low | medium | high | max
PIGO_THINKING=medium

# Anthropic-compatible endpoint (tool calling)
PIGO_BASE_URL=https://api.deepseek.com/anthropic

# Native DeepSeek endpoint (CoT / reasoner)
PIGO_DS_BASE_URL=https://api.deepseek.com

# Max agent loop iterations per request
PIGO_MAX_TURNS=50

# Auto-repair on error: true | false
# PIGO_AUTOREPAIR=true

# Session storage directory (default ~/.pigo/sessions)
# PIGO_SESSION_DIR=/path/to/sessions

# Debug: dump API requests to stderr
# PIGO_DEBUG=1
